# AlgoLens's own local Postgres (docker compose up -d postgres), on a
# non-default port so it never collides with other projects on this machine.
DATABASE_URL="postgresql://algolens:algolens@localhost:5433/algolens"

# Auth is stubbed with a local fake user for now (see src/server/stub-user.ts).
# Fill these in and swap the stub for real Clerk session lookup when ready.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Code-execution sandbox — deferred, "implement it yourself" mode shows a
# "not configured" state until this is set.
JUDGE0_URL=
